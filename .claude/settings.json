{
  "permissions": {
    "allow": [
      "Bash(./run.sh:*)",
      "Bash(python3 tools/check_docs.py:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)"
    ],
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs-drift.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
